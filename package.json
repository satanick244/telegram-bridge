{
  "name": "induport",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.java scripts/java-dev.mjs",
    "build": "vite build",
    "start": "node scripts/java-start.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "check:media": "node scripts/check_media.mjs",
    "start:legacy": "node --env-file-if-exists=.env server/index.js --production",
    "dev:legacy": "node --env-file-if-exists=.env server/index.js",
    "frontend:dev": "vite",
    "backend:dev": "node scripts/java-tools.mjs spring-boot:run -Dspring-boot.run.profiles=local",
    "build:java": "node scripts/java-tools.mjs -B package",
    "test:java": "node scripts/java-tools.mjs -B test",
    "test:java:contract": "node --test tests/java/*.test.mjs",
    "test:e2e:java": "npm run build && playwright test --config playwright.java.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=24"
  }
}
