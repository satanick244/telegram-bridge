# Local development only. Never commit your real .env file.
PORT=3000
DATABASE_CLIENT=sqlite
DATABASE_PATH=./data/induport.db
# Switch DATABASE_CLIENT to mysql only after filling all required settings.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=induport
MYSQL_USER=induport_app
MYSQL_PASSWORD=
# true for a remote MySQL endpoint with a trusted server certificate.
# false is only for localhost or an already encrypted private tunnel.
MYSQL_SSL=true
# Optional PEM CA certificate. Never disable certificate verification.
# MYSQL_SSL_CA=
# Optional platform administrator. Fill both; there is no default admin account.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional canonical public origin, e.g. https://induport-trade.onrender.com
# APP_ORIGIN=
